# snip-pin configuration: copy to ~/.config/snip-pin/config and edit.
# `key = value` lines; `#` starts a comment. An environment variable
# SNIP_PIN_<KEY> on the bound command overrides a top-level key. The viewer
# re-reads this file whenever a pin is opened, so edits apply to the next pin.

keep_days = 7                 # days to keep snips in the cache; 0 keeps them forever
tap_ms = 300                  # double-tap window (ms) for opening the history
border = #ff9f1c              # colour of the 2 px border around a pin
#save_dir = ~/Pictures/Screenshots   # where Ctrl+S saves; default: ML4W setting or the XDG pictures folder
#autosave_dir = ~/Pictures/Snips      # every capture is also saved here (raw, without annotations)
filename = pin_%Y%m%d_%H%M%S  # strftime pattern for saved files (quick save, Save as, autosave)
format = png                  # quick save and autosave: png, jpg or webp
quality = 90                  # JPEG / WebP quality, 1-100
copy_file = always            # a copied pin is offered as a file (text/uri-list) as well as image/png; never = PNG only
sound = off                   # on copy and save: off, default (the sound theme's screen-capture), or a sound file
#palette = #e5312b, #ff8c1a, #ffd21f, #2fbf4f, #2f7fe5, #ffffff, #000000   # up to 9 swatches, on keys 1-9
#widths = 2, 4, 7             # stroke widths in px, 2 to 5 values (also text size, badge and blur block size)
tool_colors = 1               # every tool remembers its own colour and width (red arrows, yellow marker, ...)
# `snip-pin.sh clipboard` with text in the clipboard renders it as an image (Snipaste's Text to Image)
text_font = Sans 11           # a Pango font description; try "Monospace 10" for code
text_width = 900              # wrap width in px
text_margin = 15              # padding in px
text_fg = #000000
text_bg = #ffffff
ocr_lang = eng                # tesseract language(s) for Copy text, e.g. eng+deu (tesseract --list-langs)
#ocr_cmd =                    # another recogniser: a command reading the PNG %f and printing text
debug = 0                     # 1 writes timestamped lines to ~/.local/state/snip-pin/log (`snip-pin.sh log`)
elements_budget_ms = 150      # time the element detector may spend joining edges

# the selection (slurp): outline colour and width, the dim over the rest of the
# screen, the fill inside the selection (#rrggbb or #rrggbbaa), size readout
sel_border = #888888ff
sel_width = 1
sel_mask = #00000080
sel_fill = #00000000
sel_size = 1                  # 0 hides the WxH readout while dragging
cursor = 0                    # 1 includes the mouse cursor in the capture
areas = 8                     # capture areas remembered for `snip-pin.sh repeat [N]`
action = copy+pin             # what a bare `snip-pin.sh` does after the capture: copy, save, pin, joined by +
default_tool = none           # tool active on a new pin: none, rect, ellipse, arrow, pen, text, counter, marker, blur
confirm_close_all = 1         # `snip-pin.sh close-all` asks before closing several pins; 0 closes at once
zoom_at_pointer = 1           # the wheel zooms around the pointer (the pin moves); 0 keeps the top-left corner
smooth = 1                    # bilinear scaling; 0 draws crisp pixel blocks when zoomed in (menu: Smooth scaling)
reopen = 5                    # closed pins `snip-pin.sh reopen` can bring back; 0 turns it off
opacity = 100                 # starting opacity of a pin, 10-100; Ctrl+1 returns to it
alpha_bg = transparent        # behind transparent images: transparent (desktop shows through), checker, or #rrggbb
thumb_size = 75               # side of the tile a pin collapses into (Ctrl+M, Shift + double-click)

[keys]
# action = binding [binding ...]; modifiers ctrl, shift, alt, super; an empty
# value unbinds. Key names as GDK knows them (Escape, Return, F10, bracketleft,
# comma, ...) or a single character. Defaults shown.
#copy = ctrl+c
#save = ctrl+s
#save_as = ctrl+shift+s       # file dialog; PNG, JPEG or WebP by the extension you type; the pin stays open
#print = ctrl+p               # GTK's print dialog (printers, print to PDF); the pin stays open
#ocr = ctrl+shift+c           # copy the recognised text; with a crop marquee drawn, only that part
#open_with =                  # the desktop's application chooser for the image
#command_1 = ctrl+shift+1     # ... command_9: the [commands] entries in order
#close =                      # close without copying (cancel does that when no tool is active)
#destroy = shift+Escape       # close for good: `reopen` cannot bring it back
#cancel = Escape              # cancel crop / deselect tool / close
#confirm = Return KP_Enter    # apply crop, commit text
#undo = ctrl+z
#redo = ctrl+shift+z ctrl+y
#reset = ctrl+0               # zoom, opacity, rotation and flips back to normal
#reset_zoom =
#reset_opacity = ctrl+1
#rotate_cw = ctrl+r
#rotate_ccw = ctrl+shift+r
#flip_h = ctrl+h
#flip_v = ctrl+j
#smooth =                     # toggle smooth scaling
#thumbnail = ctrl+m shift+Return   # collapse into a tile; with a crop marquee, only that part
#click_through = ctrl+t       # the pin ignores the mouse until `snip-pin.sh clickthrough` (a bind) undoes it
#width_down = bracketleft
#width_up = bracketright
#menu = F10
#tool_rect = r
#tool_ellipse = e
#tool_arrow = a
#tool_pen = p
#tool_text = t
#tool_counter = n
#tool_marker = m
#tool_blur = b
#tool_crop = c
#tool_eraser = x
#delete = Delete              # remove the selected annotation
#color_1 = 1                  # ... color_7 = 7

[mouse]
# right, double, shift_double and middle click: copy, save, save_as, print, ocr, open_with, close,
# destroy, menu, reset, reset_zoom, thumbnail, command_1 ... command_9 or none
#right = copy
#double = copy
#shift_double = thumbnail
#middle = menu

[commands]
# Programs to send a pin to, in the menu under "Send to"; the first nine get
# Ctrl+Shift+1 ... 9. %f is a temporary PNG with the annotations baked in,
# %F the original file, %% a literal percent sign.
#Open in GIMP = gimp %f
#Upload = sh -c 'curl -sF "file=@%f" https://0x0.st | wl-copy'
#Copy path = sh -c 'printf %%s "%F" | wl-copy'
