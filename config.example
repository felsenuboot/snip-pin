# snip-pin configuration: copy to ~/.config/snip-pin/config and edit.
# `key = value` lines; `#` starts a comment. An environment variable
# SNIP_PIN_<KEY> on the bound command overrides a top-level key. The viewer
# re-reads this file whenever a pin is opened, so edits apply to the next pin.

keep_days = 7                 # days to keep snips in the cache; 0 keeps them forever
tap_ms = 300                  # double-tap window (ms) for opening the history
border = #ff9f1c              # colour of the 2 px border around a pin
#save_dir = ~/Pictures/Screenshots   # where Ctrl+S saves; default: ML4W setting or the XDG pictures folder
#autosave_dir = ~/Pictures/Snips      # every capture is also saved here (raw, without annotations)
elements_budget_ms = 150      # time the element detector may spend joining edges

# the selection (slurp): outline colour and width, the dim over the rest of the
# screen, the fill inside the selection (#rrggbb or #rrggbbaa), size readout
sel_border = #888888ff
sel_width = 1
sel_mask = #00000080
sel_fill = #00000000
sel_size = 1                  # 0 hides the WxH readout while dragging
cursor = 0                    # 1 includes the mouse cursor in the capture
areas = 8                     # capture areas remembered for `snip-pin.sh repeat [N]`
action = copy+pin             # what a bare `snip-pin.sh` does after the capture: copy, save, pin, joined by +
default_tool = none           # tool active on a new pin: none, rect, ellipse, arrow, pen, text, counter, marker, blur

[keys]
# action = binding [binding ...]; modifiers ctrl, shift, alt, super; an empty
# value unbinds. Key names as GDK knows them (Escape, Return, F10, bracketleft,
# comma, ...) or a single character. Defaults shown.
#copy = ctrl+c
#save = ctrl+s
#close =                      # close without copying (cancel does that when no tool is active)
#cancel = Escape              # cancel crop / deselect tool / close
#confirm = Return KP_Enter    # apply crop, commit text
#undo = ctrl+z
#redo = ctrl+shift+z ctrl+y
#reset_zoom = ctrl+0
#reset_opacity = ctrl+1
#width_down = bracketleft
#width_up = bracketright
#menu = F10
#tool_rect = r
#tool_ellipse = e
#tool_arrow = a
#tool_pen = p
#tool_text = t
#tool_counter = n
#tool_marker = m
#tool_blur = b
#tool_crop = c
#color_1 = 1                  # ... color_7 = 7

[mouse]
# right, double and middle click: copy, save, close, menu, reset_zoom or none
#right = copy
#double = copy
#middle = menu
